{
  "name": "google-drive-utils",
  "version": "0.1.0",
  "description": "Download Google Drive folders as one ZIP, one ZIP per subfolder, or individual files.",
  "main": "src/main/index.js",
  "author": "Lucas Donini",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "preview:ui": "node scripts/ui-preview.js",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac zip"
  },
  "dependencies": {
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lucasdonini.googledriveutils",
    "productName": "Google Drive Utils",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.utilities"
    }
  }
}
